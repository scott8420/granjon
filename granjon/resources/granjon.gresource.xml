<?xml version="1.0" encoding="UTF-8"?>
<!-- Granjon resource bundle. The resource-pipeline paradigm: an app asset carried
     the symbolic way (a currentColor SVG under the freedesktop icon-theme shape)
     so set_icon_name("granjon-logo-symbolic") resolves it out of the compiled-in
     binary and GTK recolours it to the theme foreground -- no icon installed on
     the user's disk.

     Gotcha the shape encodes: GTK's icon lookup is RIGID about the trailing
     .../scalable/apps/ path, so the prefix ends there and App::on_activate
     passes only /io/github/granjon/Granjon/icons to add_resource_path (GTK appends
     scalable/apps/ itself). The prefix mirrors the app-id; both move together in
     a one-pass rename. See docs/resources-and-dialog-lifetime.md. -->
<gresources>
  <gresource prefix="/io/github/granjon/Granjon/icons/scalable/apps">
    <file preprocess="xml-stripblanks" alias="granjon-logo-symbolic.svg">icons/scalable/apps/granjon-logo-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="granjon-tool-pick-symbolic.svg">icons/scalable/apps/granjon-tool-pick-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="granjon-tool-pen-symbolic.svg">icons/scalable/apps/granjon-tool-pen-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="granjon-tool-measure-symbolic.svg">icons/scalable/apps/granjon-tool-measure-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="granjon-tool-hand-symbolic.svg">icons/scalable/apps/granjon-tool-hand-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="granjon-view-fill-symbolic.svg">icons/scalable/apps/granjon-view-fill-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="granjon-view-context-symbolic.svg">icons/scalable/apps/granjon-view-context-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="granjon-view-grid-symbolic.svg">icons/scalable/apps/granjon-view-grid-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="granjon-view-snap-symbolic.svg">icons/scalable/apps/granjon-view-snap-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="granjon-view-image-symbolic.svg">icons/scalable/apps/granjon-view-image-symbolic.svg</file>
  </gresource>
  <gresource prefix="/io/github/granjon/Granjon">
    <file>granjon.css</file>
  </gresource>
</gresources>
